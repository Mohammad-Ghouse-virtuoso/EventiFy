DATABASE_URL=postgresql://eventify_user:eventify_pass@localhost:5432/eventify_db
SECRET_KEY=PUT_A_STRONG_RANDOM_VALUE
REFRESH_SECRET_KEY=PUT_A_STRONG_RANDOM_VALUE_FOR_REFRESH
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Argon2id hashing settings (sane defaults for security/perf)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=102400
ARGON2_PARALLELISM=8

# Login rate limiting (attempts per IP per minute)
LOGIN_RATE_LIMIT_PER_MINUTE=5
UPLOAD_DIR=uploads

# Base URL used to construct absolute links for static assets and callbacks
BASE_URL=http://localhost:8000

# Absolute path to static directory (where /static is mounted). Optional.
# Default is backend/app/../static
# STATIC_DIR=/abs/path/to/static