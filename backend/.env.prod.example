# Production environment example (PostgreSQL)
# Copy to .env or set as environment variables in your hosting platform.
ENVIRONMENT=prod

# Database URL (PostgreSQL)
# Example: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>
# DATABASE_URL=postgresql+psycopg2://samrat:password123@localhost:5432/eventify

# Secrets - set securely in your platform, do not commit real values
SECRET_KEY=replace-with-strong-secret
REFRESH_SECRET_KEY=replace-with-strong-refresh-secret

# Public base URL
BASE_URL=https://your-domain.example.com

# Argon2id parameters (production): stronger defaults for real deployments
# Dev/test typically use lower settings (e.g., TIME_COST=2, MEMORY_COST=51200, PARALLELISM=2)
# Review based on your CPU/RAM capacity; higher costs increase login latency but improve security.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Rate limiting policy
LOGIN_RATE_LIMIT_PER_MINUTE=5
