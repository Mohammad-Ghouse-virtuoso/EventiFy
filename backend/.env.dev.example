# Local development environment (SQLite)
# Use this for local runs and k6 tests.
ENVIRONMENT=dev
DATABASE_URL=sqlite:///./eventify.db

# JWT secrets for local only (replace as needed for dev)
SECRET_KEY=dev-secret-please-change
REFRESH_SECRET_KEY=dev-refresh-secret-please-change

# Base URL used for links
BASE_URL=http://localhost:8000

# Argon2id parameters (dev/test): tuned lower for faster local runs and k6
# Approx target: ~200–300ms p95 for 50 concurrent logins on typical laptops
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=51200
ARGON2_PARALLELISM=2

# Login rate limiting (per-IP per minute)
LOGIN_RATE_LIMIT_PER_MINUTE=500

# Hugging Face API Configuration
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_token_here

# Recommended image models (Stable Diffusion 3 is deprecated):
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0  (Stable, reliable)
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell  (Faster, newer)
# HF_IMAGE_MODEL=stabilityai/sdxl-turbo  (Very fast)
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
